@model ProdutoModel

<h1>Detalhes do Produto</h1>    

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="well">

                <dl class="row">
                    <dt class="col-sm-3">ID do Produto</dt>
                    <dd class="col-sm-9">@Model.ProdutoId</dd>

                    <dt class="col-sm-3">Nome do Produto</dt>
                    <dd class="col-sm-9">@Model.NomeProduto</dd>

                    <dt class="col-sm-3">Sugestão</dt>
                    <dd class="col-sm-9">@Model.SugestaoTroca</dd>

                    <dt class="col-sm-3">Categoria</dt>
                    <dd class="col-sm-9">@Model.CategoriaId</dd>

                    <dt class="col-sm-3">Disponível</dt>
                    <dd class="col-sm-9">@Model.Disponivel</dd>

                    <dt class="col-sm-3">Data de Expiração</dt>
                    <dd class="col-sm-9">@Model.DataExpiracao</dd>
                </dl>

                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </div>
    </div>
</div>
