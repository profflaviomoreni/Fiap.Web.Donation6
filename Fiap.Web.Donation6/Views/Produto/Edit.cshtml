@model ProdutoModel

<h1>Editar Produto</h1>

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="well">

                @if ( ! string.IsNullOrEmpty(ViewBag.ErrorMessage) ) {
                    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                }

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="ProdutoId" />
                    <div class="form-group">
                        <label asp-for="NomeProduto" class="control-label"></label>
                        <input asp-for="NomeProduto" class="form-control" />
                        <span asp-validation-for="NomeProduto" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Sugestão</label>
                        <input type="text" name="SugestaoTroca" value="@Model.SugestaoTroca" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="CategoriaId" class="control-label"></label>
                        <input asp-for="CategoriaId" class="form-control" />
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Disponivel" class="control-label"></label>
                        <input asp-for="Disponivel" class="form-control" />
                        <span asp-validation-for="Disponivel" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DataExpiracao" class="control-label"></label>
                        <input asp-for="DataExpiracao" class="form-control" />
                        <span asp-validation-for="DataExpiracao" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Salvar" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>